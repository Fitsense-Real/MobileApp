<?xml version="1.0" encoding="utf-8"?>
<!-- Kora launcher icon on Android 8+: lime background, forest glyph, and a
     monochrome layer for themed icons (Android 13+). Android 7.x uses the
     PNGs in mipmap-*dpi, rendered from the same artwork. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/kora_icon_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
